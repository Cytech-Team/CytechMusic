# -------------------------------------------------------------------------
# CytechMusic - .env Configuration Template
# -------------------------------------------------------------------------

# [Bot Credentials]
BOT_TOKEN=your_discord_bot_token_here
NEW_BOT_ID=your_bot_id_here
OWNER_IDS=your_discord_user_id,another_owner_id
DEFAULT_PREFIX=cm!

# [Database]
MONGO_URI=mongodb://localhost:27017
DB_NAME=CytechMusic

# [Lavalink Connection]
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASS=youshallnotpass
LAVALINK_ID=MainNode

# [Spotify API]
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# [Lyrics API]
GENIUS_TOKEN=

# [Optional Top.gg]
DBL_TOKEN=

# [Optional Stripe / Dashboard]
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROXY_URL=
STRIPE_SUCCESS_URL=http://localhost:3000/success
STRIPE_CANCEL_URL=http://localhost:3000/premium
DOMAIN_URL=http://localhost:3000
WEB_PORT=3000

# [UI & Branding]
EMBED_COLOR=0xFFD700
ERROR_COLOR=0xFF0000
SUCCESS_COLOR=0x00FF00
BANNER_URL=
SUPPORT_URL=
DASHBOARD_URL=http://localhost:3000/dashboard
INVITE_URL=http://localhost:3000/invite
DONATE_URL=
VOTE_URL=

# [Logging]
ERROR_LOG_WEBHOOK=
LOG_WEBHOOK_URL=
LOG_CHANNEL_ID=0

# [Optional cross-server role sync]
# Leave both at 0 to disable unless you intentionally configure this feature.
SOURCE_GUILD_ID=0
SYNC_ROLE_ID=0

# [Misc]
VERSION=1.0.1-revival
DEV_MODE=false
IMPERSONATE_MAIN=false
DEPRECATED_MODE=false
TEST_GUILD_ID=0
