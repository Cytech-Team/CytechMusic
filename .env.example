# -------------------------------------------------------------------------
# Cyori Bot - .env Configuration Template
# -------------------------------------------------------------------------

# [Bot Credentials]
BOT_TOKEN=your_discord_bot_token_here
NEW_BOT_ID=your_bot_id_here
OWNER_IDS=your_discord_user_id,another_owner_id
DEFAULT_PREFIX=cm!

# [Database]
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=Cyori

# [Lavalink Connection]
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASS=youshallnotpass
LAVALINK_ID=MainNode

# [Spotify API]
SPOTIFY_CLIENT_ID=optional_spotify_id
SPOTIFY_CLIENT_SECRET=optional_spotify_secret

# [Lyrics API]
GENIUS_TOKEN=optional_lyrics_genius_token

# [Stripe Payment (Premium)]
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=https://yourdomain.com/success
STRIPE_CANCEL_URL=https://yourdomain.com/premium
DOMAIN_URL=http://localhost:3000

# [UI & Branding]
EMBED_COLOR=0xFFD700
ERROR_COLOR=0xFF0000
SUCCESS_COLOR=0x00FF00
BANNER_URL=https://i.postimg.cc/5y5pk1bL/Cyori-Banner.png
SUPPORT_URL=https://discord.gg/your_support_server

# [Logging]
ERROR_LOG_WEBHOOK=optional_webhook_url
LOG_CHANNEL_ID=optional_channel_id

# [Misc]
VERSION=1.0.0
DEV_MODE=false
SOURCE_GUILD_ID=1413525842490953891
SYNC_ROLE_ID=1413696208920117368
